# Copy to .env and fill in real values. Never commit .env.

# --- Secrets ---
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
TAVILY_API_KEY=

# --- LLM settings ---
JARVIS_LLM_PROVIDER=openai
JARVIS_LLM_MODEL=gpt-5-mini
# Cap includes reasoning tokens, so keep headroom above the visible reply length.
JARVIS_MAX_OUTPUT_TOKENS=1000
JARVIS_LLM_TIMEOUT_SECONDS=30
# Number of past user/assistant turns sent with each request.
JARVIS_HISTORY_TURNS=10
# Reasoning effort: none|minimal|low|medium|high|xhigh|max (model-dependent). Blank = provider default.
JARVIS_REASONING_EFFORT=low

# --- Voice (used by `jarvis --voice`) ---
# Where models, benchmark audio, etc. are stored (relative to the project root). Gitignored.
JARVIS_DATA_DIR=data
# openai = cloud transcription (audio is sent to OpenAI; ~$0.003/minute; owner decision 2026-09-28).
# faster-whisper = fully local.
JARVIS_STT_PROVIDER=openai
# Model for the provider above: e.g. gpt-4o-mini-transcribe (openai) or base.en (faster-whisper).
JARVIS_STT_MODEL=gpt-4o-mini-transcribe
# Local faster-whisper model used when the cloud fails or you are offline. Blank = no fallback.
JARVIS_STT_FALLBACK_MODEL=base.en
JARVIS_STT_COMPUTE_TYPE=int8
JARVIS_STT_BEAM_SIZE=5
JARVIS_TTS_PROVIDER=sapi
# Optional speaking rate (words per minute) for the local voice. Blank = Windows default.
JARVIS_TTS_RATE=
# Hold this key to talk. ctrl_r = Right Ctrl (HP top-row keys send action keys, not F-keys, unless Fn is held).
JARVIS_PTT_KEY=ctrl_r
JARVIS_MAX_RECORD_SECONDS=30

# --- ElevenLabs (premium voice) ---
# Comma list of what ElevenLabs is used for: briefing, reply. Blank = disabled (local voice only).
JARVIS_ELEVENLABS_USE_FOR=
# Voice ID from your ElevenLabs voice library.
JARVIS_ELEVENLABS_VOICE_ID=
JARVIS_ELEVENLABS_MODEL=eleven_flash_v2_5
# Fall back to the local voice when fewer characters than this remain this month.
JARVIS_ELEVENLABS_MIN_CHARS=1000

# --- File search (tools) ---
# Folders file search may index and open, separated by ";" (absolute paths). Blank = file search off.
# The Jarvis project folder itself, hidden folders, and developer folders (node_modules, venv, ...) are always skipped.
JARVIS_FILE_SEARCH_DIRS=

# --- Web search (tools) ---
# tavily = Tavily Search API (1 credit per search; free plan 1,000 credits/month). Blank = web search off.
JARVIS_SEARCH_PROVIDER=tavily

# --- Memory (Phase 4) ---
# Embedding model for smart recall of remembered facts (memory text is sent to OpenAI to find relevant facts;
# ~$0.02 per 1M tokens). Blank = no smart recall: Jarvis uses the most recent memories instead.
JARVIS_EMBEDDING_MODEL=text-embedding-3-small
