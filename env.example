# Copy to .env and fill in real values. Never commit .env.

# --- Secrets ---
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# --- LLM settings ---
JARVIS_LLM_PROVIDER=openai
JARVIS_LLM_MODEL=gpt-5-nano
# Cap includes reasoning tokens, so keep headroom above the visible reply length.
JARVIS_MAX_OUTPUT_TOKENS=1000
JARVIS_LLM_TIMEOUT_SECONDS=30
# Number of past user/assistant turns sent with each request.
JARVIS_HISTORY_TURNS=10
# Reasoning effort: none|minimal|low|medium|high|xhigh|max (model-dependent). Blank = provider default.
JARVIS_REASONING_EFFORT=low
